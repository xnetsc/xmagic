# The one public port. Everything (SSH, SOCKS5, HTTP proxy, WS, bare
# Shadowsocks) arrives here and is dispatched by first bytes.
XRAY_PORT=8080

# WebSocket paths for VLESS / Trojan - comma-separated lists, EVERY path
# is live at once (one backend per path, same users). Mint random ones
# with: users.py gen-paths 8
VLESS_WS_PATHS=/vless-ws
TROJAN_WS_PATHS=/trojan-ws

# Default Shadowsocks method for new users.
SS_METHOD=aes-256-gcm

# Cascade: how this node picks among multiple upstreams of a group -
# random | roundRobin | leastPing | leastLoad
UPSTREAM_STRATEGY=roundRobin

# sshd backend port (the dispatcher forwards SSH banners here; only the
# dispatcher should reach it - it forwards to 127.0.0.1 only).
SSH_BE_PORT=12222

# Admin console: it shares the public XRAY_PORT - the dispatcher sends
# origin-form HTTP (browser) traffic to it and proxy traffic to the
# proxy. ADMIN_BE_PORT is the loopback backend port between the
# dispatcher and the console container; it is never public.
# ADMIN_BE_PORT=18090

# WebAuthn relying-party id + allowed origins for the console. The
# defaults fit http://localhost access (a secure context). If the
# console is served on a domain behind HTTPS, set both to that domain:
# XMAGIC_ADMIN_RPID=admin.example.com
# XMAGIC_ADMIN_ORIGINS=https://admin.example.com

# Optional port overrides (defaults in the users.py docstring):
# XRAY_MUX_PORT=18080 BE_HTTP_PORT=18081 BE_SOCKS_PORT=18082
# XRAY_REALITY_PORT=18083
# SS_BE_PORT=12003 VLESS_BE_BASE=12100 TROJAN_BE_BASE=12200
# SSH_TUNNEL_BASE=13000

# Business database: SQLite by default (PROXY_DB, ./data/users.db).
# PostgreSQL / MySQL databases are configured at runtime from the web
# console or the CLIs (multiple named configs, switchable, with data
# migration between them); the configs themselves are stored in a local
# SQLite file next to the default database:
# XMAGIC_LOCAL_DB=/data/local.db

# Allow direct egress to private / LAN addresses (default off: traffic
# arriving over VLESS / Trojan / Shadowsocks cannot reach the node's
# own LAN). Can also be toggled at runtime in the console settings.
# DIRECT_ALLOW_PRIVATE=1
# VLESS inbounds are off by default (the protocol has no encryption of
# its own); set to 1 to render them anyway, or toggle per node in the
# console / CLI settings (the database value wins).
# VLESS_ENABLED=1
# The VLESS+REALITY inbound is ON by default and independent of the
# VLESS switch above (REALITY carries its own encryption); the camouflage
# target and names can also be set per node in the console / CLI
# settings (the database value wins). REALITY_ENABLED=0 turns it off.
# REALITY_DEST=www.microsoft.com:443
# REALITY_SERVER_NAMES=www.microsoft.com
# REALITY_SHORT_IDS=
# Public SOCKS5 is off by default (no encryption of its own, and not
# HTTP so it cannot ride the HTTPS endpoint); set to 1 to let the
# dispatcher route SOCKS5 greetings again.
# XMAGIC_ENABLE_SOCKS5=1
