# Pinned upstream versions - the single place they are recorded.
# XRAY_VERSION: the ghcr.io/xtls/xray-core image tag (no leading "v").
# .github/workflows/upstream-check.yml polls XTLS/Xray-core releases
# daily; on a new release it bumps this pin, commits, and triggers a
# rebuild, so published images always track the latest Xray.
XRAY_VERSION=26.11.9
