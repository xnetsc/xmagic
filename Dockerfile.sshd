# SSH entry for the gateway node: one system user `proxy`, key-only auth,
# TCP forwarding on (that's what `ssh -D` needs), shell present but the
# account is meant for proxying. authorized_keys is rendered by users.py
# from the same SQLite DB as the Xray config into the data directory
# (mounted at /data); the entrypoint copies it into the proxy home at
# every start - the compose apply path restarts this container after
# each render, so key changes propagate. (A single-file bind mount of
# authorized_keys is NOT used: Docker turns a missing source file into
# a directory on first up, which sshd then refuses as not-a-file.)
FROM alpine:3.20
RUN apk add --no-cache openssh-server \
 && adduser -D -s /bin/false proxy \
 && passwd -u proxy \
 && mkdir -p /home/proxy/.ssh /etc/ssh/keys \
 && chown proxy:proxy /home/proxy/.ssh && chmod 700 /home/proxy/.ssh
COPY sshd_config /etc/ssh/sshd_config
EXPOSE 12222
CMD ["sh", "-c", "for t in rsa ecdsa ed25519; do [ -f /etc/ssh/keys/ssh_host_${t}_key ] || ssh-keygen -t $t -f /etc/ssh/keys/ssh_host_${t}_key -N ''; done; if [ -f /data/authorized_keys ]; then cp /data/authorized_keys /home/proxy/.ssh/authorized_keys; else : > /home/proxy/.ssh/authorized_keys; fi; chown proxy:proxy /home/proxy/.ssh/authorized_keys; chmod 0644 /home/proxy/.ssh/authorized_keys; exec /usr/sbin/sshd -D -e -p ${SSH_BE_PORT:-12222}"]
